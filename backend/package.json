{
  "name": "personal-assistant-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Backend do Personal Assistant — captura, sincronizacao, IA e validacao de Registros",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "db:migrate": "sequelize-cli db:migrate --config sequelize.config.js",
    "db:migrate:undo": "sequelize-cli db:migrate:undo --config sequelize.config.js",
    "db:seed": "sequelize-cli db:seed:all --config sequelize.config.js",
    "db:seed:undo": "sequelize-cli db:seed:undo:all --config sequelize.config.js",
    "criar-usuario": "node scripts/criar-usuario.js",
    "importar-bodymove": "node scripts/importar-avaliacoes-bodymove.js",
    "recalcular-derivadas-af": "node scripts/recalcular-derivadas-avaliacao-fisica.js",
    "test": "cross-env NODE_ENV=test node --test"
  },
  "dependencies": {
    "@google/genai": "^2.15.0",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.2.0",
    "pg": "^8.16.3",
    "pg-hstore": "^2.3.4",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "sequelize": "^6.37.7",
    "sequelize-cli": "^6.6.3"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "mdb-reader": "^3.2.0",
    "nodemon": "^3.1.10",
    "pino-pretty": "^13.0.0"
  }
}
