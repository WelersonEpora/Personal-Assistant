# Variáveis usadas pelo Docker Compose (docker/compose.dev.yml e
# docker/compose.prod.yml) e lidas por backend/sequelize.config.js e
# backend/src/config/env.js (que resolvem este .env da raiz). Copiar para
# .env e ajustar. Nunca commitar o .env real.

# ---- Postgres --------------------------------------------------------
POSTGRES_PORT=5432
POSTGRES_INITDB_DATABASE=personal_assistant
POSTGRES_INITDB_USER=personal_assistant
POSTGRES_INITDB_PASSWORD=personal_assistant

# usados pelo backend (dev local e dentro dos containers)
POSTGRES_HOST=localhost
POSTGRES_DB=personal_assistant
POSTGRES_USER=personal_assistant
POSTGRES_PASSWORD=personal_assistant
POSTGRES_DB_TEST=personal_assistant_test

# ---- pgAdmin (docker/compose.dev.yml, só desenvolvimento) -------------
PGADMIN_PORT=5050
PGADMIN_DEFAULT_EMAIL=dev@personal-assistant.local
PGADMIN_DEFAULT_PASSWORD=personal_assistant

# ---- Backend ------------------------------------------------------------
APP_PORT=3000
NODE_ENV=development
JWT_SECRET=troque-este-valor
JWT_EXPIRES_IN=12h
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
AUDIO_STORAGE_DIR=storage/audio
FOTO_STORAGE_DIR=storage/fotos

# ---- Publicação (docker/compose.prod.yml) --------------------------------
BACKEND_IMAGE=ghcr.io/welersonepora/personal-assistant-backend
FRONTEND_IMAGE=ghcr.io/welersonepora/personal-assistant-frontend
BACKEND_IMAGE_TAG=latest
FRONTEND_IMAGE_TAG=latest
# 8081 já é do AgroMind na mesma VM de produção - Personal Assistant usa 8082.
FRONTEND_PORT=8082
